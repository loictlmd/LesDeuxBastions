{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "regions": [
    "fra1"
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "public/assets/arena.svg"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api?route=/api/:path*"
    },
    {
      "source": "/assets/arena.svg",
      "destination": "/api?route=/assets/arena.svg"
    }
  ],
  "crons": [
    {
      "path": "/api/cleanup",
      "schedule": "0 4 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        }
      ]
    }
  ]
}
